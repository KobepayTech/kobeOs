# ═══════════════════════════════════════════════════════════════════════════════
# KobeOS Production Environment
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and supply every value marked as a secret through your
# deployment secret store. Never commit real provider secrets into this file.
#
#   cp .env.production .env
#   npm run start:prod

# ══ REQUIRED: Cloudflare (for store publishing) ══════════════════════════════
# Get these from https://dash.cloudflare.com:
# API Token needs Cloudflare Tunnel:Edit + Zone:DNS:Edit.
CF_API_TOKEN=YOUR_CF_API_TOKEN_HERE
CF_ACCOUNT_ID=YOUR_CF_ACCOUNT_ID_HERE
CF_ZONE_ID=YOUR_CF_ZONE_ID_HERE
# CF_DOMAIN=kobeapptz.com

# ══ DATABASE (PostgreSQL) ════════════════════════════════════════════════════
NODE_ENV=production
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=kobe
DB_PASSWORD=kobe
DB_DATABASE=kobeos
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# ══ AUTH ═════════════════════════════════════════════════════════════════════
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=30

# ══ AI / LLM (Ollama) ════════════════════════════════════════════════════════
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
AI_VISION_MODEL=qwen2.5vl:7b

# ══ CORS ═════════════════════════════════════════════════════════════════════
CORS_ORIGIN=https://kobeapptz.com,https://app.kobeapptz.com,http://localhost:5173,http://127.0.0.1:5173
TENANT_BASE_DOMAIN=kobeapptz.com

# ══ PalmPesa (USSD payments) ═════════════════════════════════════════════════
PALMPESA_API_TOKEN=
PALMPESA_USER_ID=531
APP_PUBLIC_URL=https://api.kobeapptz.com
APP_FRONTEND_URL=https://kobeapptz.com/

# ══ Meta / Instagram Professional ════════════════════════════════════════════
# Supply real values through the production secret store.
# Instagram OAuth callback:
# https://api.kobeapptz.com/api/live-sales/instagram/oauth/callback
# Instagram webhook callback:
# https://api.kobeapptz.com/api/live-sales/public/webhooks/instagram
INSTAGRAM_APP_ID=1754586998908005
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://api.kobeapptz.com/api/live-sales/instagram/oauth/callback
INSTAGRAM_API_VERSION=v26.0
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_comments,instagram_business_manage_messages,instagram_business_manage_insights
IG_WEBHOOK_VERIFY_TOKEN=

# Facebook/Meta login callback:
# https://api.kobeapptz.com/api/auth/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://api.kobeapptz.com/api/auth/oauth/meta/callback
META_GRAPH_VERSION=v26.0

# ══ TikTok Login Kit + Creator Content Posting ═══════════════════════════════
# Register both callbacks in the same TikTok developer app, enable Content
# Posting API, obtain approval for video.publish, and verify api.kobeapptz.com
# (or the exact public media URL prefix) before using PULL_FROM_URL.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.kobeapptz.com/api/auth/oauth/tiktok/callback
TIKTOK_CREATOR_REDIRECT_URI=https://api.kobeapptz.com/api/social-scheduler/tiktok/oauth/callback
TIKTOK_CREATOR_OAUTH_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list,video.publish

# ══ License ══════════════════════════════════════════════════════════════════
LICENSE_HMAC_SECRET=kobe-license-secret-change-in-prod
