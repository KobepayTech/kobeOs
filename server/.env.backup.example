# KobeOS independent backup production example.
# Copy to server/.env.backup on the BACKUP VPS only. Never commit real values.

NODE_ENV=production
PORT=3000

# Independent public hostnames. These must resolve directly to the backup VPS
# using a DNS provider that does not depend on the primary Cloudflare zone.
BACKUP_API_HOST=api-backup.example.net
BACKUP_WEB_HOST=lala-backup.example.net
ACME_EMAIL=ops@example.net

# SAME managed PostgreSQL cluster used by primary production.
DB_HOST=managed-postgres.example.net
DB_PORT=5432
DB_USERNAME=kobe
DB_PASSWORD=CHANGE_ME
DB_DATABASE=kobeos
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Required KobeOS server secrets.
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_CHARACTERS
PROVIDER_ENCRYPTION_KEY=CHANGE_ME_TO_STABLE_SECRET
TENANT_BASE_DOMAIN=kobeapptz.com

# Allows the independent GitHub Pages emergency frontend to call this API.
# Add any other independent frontend origin as a comma-separated value.
CORS_ORIGIN=https://kobepaytech.github.io

# Optional provider/app credentials should mirror primary production where
# those integrations must remain available during failover.
