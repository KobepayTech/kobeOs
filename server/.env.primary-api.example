# KobeOS always-on primary API origin.
# Copy to server/.env.primary-api on the VPS only. Never commit real values.

NODE_ENV=production
PORT=3000
API_HOST=api.kobeapptz.com
ACME_EMAIL=ops@kobeapptz.com

# Use the managed/shared PostgreSQL database that remains the source of truth.
DB_HOST=managed-postgres.example.net
DB_PORT=5432
DB_USERNAME=kobe
DB_PASSWORD=CHANGE_ME
DB_DATABASE=kobeos
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_CHARACTERS
PROVIDER_ENCRYPTION_KEY=CHANGE_ME_TO_STABLE_SECRET
TENANT_BASE_DOMAIN=kobeapptz.com

# Keep the production web origins allowed after the API origin moves.
CORS_ORIGIN=https://lala.kobeapptz.com,https://kobeapptz.com,https://www.kobeapptz.com

# Copy any other provider credentials required by production integrations
# from the current origin into this host-local file.
