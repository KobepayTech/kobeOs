{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "\\.spec\\.ts$",
  "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "isolatedModules": true }] },
  "moduleNameMapper": { "^src/(.*)$": "<rootDir>/src/$1" },
  "maxWorkers": 1,
  "testTimeout": 30000
}
