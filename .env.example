# KobeOS Frontend Environment
# Copy to .env.local for local development, or set in your CI/CD pipeline for production builds.

# Backend API base URL.
# - Local dev:    http://localhost:3000/api  (default — no need to set)
# - Production:   https://api.kobeapptz.com/api
VITE_API_BASE=https://api.kobeapptz.com/api
# PayPal Orders v2 — use sandbox credentials until checkout is verified.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Public KobeOS URL used for payment return/cancel links.
APP_PUBLIC_URL=https://kobeapptz.com

# PalmPesa merchant credentials used for mobile-money checkout.
PALMPESA_API_TOKEN=
PALMPESA_USER_ID=

# Public base for developer API quick-start snippets.
VITE_DEVELOPER_API_BASE=https://api.kobeapptz.com/api
