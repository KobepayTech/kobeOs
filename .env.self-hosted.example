# Copy to .env.self-hosted and replace the two values marked CHANGE-ME.
# This file is for the local Docker self-hosted stack, not the hosted service.

NODE_ENV=production
PORT=3000

DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=kobe
DB_PASSWORD=CHANGE-ME-use-a-strong-database-password
DB_DATABASE=kobeos
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

JWT_SECRET=CHANGE-ME-use-at-least-32-random-characters
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=30

REDIS_URL=redis://redis:6379
KOBEOS_DEPLOYMENT=self-hosted
KOBEOS_DESKTOP=false

CORS_ORIGIN=http://localhost:8080
TENANT_BASE_DOMAIN=
APP_PUBLIC_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:8080/

# The SPA is built with this value and calls the API directly on localhost.
API_PORT=3000
WEB_PORT=8080
VITE_API_BASE=http://localhost:3000/api
VITE_TENANT_BASE_DOMAIN=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Optional integrations. Leave blank until configured with your own provider credentials.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v26.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
