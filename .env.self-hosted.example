# Copy to .env.self-hosted and replace the two values marked CHANGE-ME.
# This file is for the local Docker self-hosted stack, not the hosted service.

NODE_ENV=production
PORT=3000

DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=kobe
DB_PASSWORD=CHANGE-ME-use-a-strong-database-password
DB_DATABASE=kobeos
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

JWT_SECRET=CHANGE-ME-use-at-least-32-random-characters
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=30

REDIS_URL=redis://redis:6379
KOBEOS_DEPLOYMENT=self-hosted
KOBEOS_DESKTOP=false

CORS_ORIGIN=http://localhost:8080
TENANT_BASE_DOMAIN=
APP_PUBLIC_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:8080/

# Keep the SPA on same-origin /api so QR setup links work from another LAN device.
API_PORT=3000
WEB_PORT=8080
VITE_API_BASE=/api
VITE_TENANT_BASE_DOMAIN=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Optional first-boot admin. Set these temporarily, start the stack once,
# sign in, then remove all KOBEOS_BOOTSTRAP_ADMIN_* lines and restart.
# Existing users are never promoted or have their passwords changed.
KOBEOS_BOOTSTRAP_ADMIN_EMAIL=
KOBEOS_BOOTSTRAP_ADMIN_PASSWORD=
KOBEOS_BOOTSTRAP_ADMIN_DISPLAY_NAME=KobeOS Test Admin

# Optional integrations. Leave blank until configured with your own provider credentials.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Public Meta Login for Business configuration used by the default KobeOS app.
META_LOGIN_CONFIG_ID=1589072156006100
META_GRAPH_VERSION=v26.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
