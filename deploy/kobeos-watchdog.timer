# systemd timer: fire the KobeOS uptime watchdog every 60 seconds, and once
# shortly after boot so a server reboot self-recovers even if a container was
# slow to come up. Persistent=true catches up a missed run after downtime.
[Unit]
Description=Run the KobeOS uptime watchdog every minute

[Timer]
OnBootSec=45s
OnUnitActiveSec=60s
AccuracySec=10s
Persistent=true

[Install]
WantedBy=timers.target
